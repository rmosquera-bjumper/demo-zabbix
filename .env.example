POSTGRES_USER=zabbix
POSTGRES_PASSWORD=zabbix_secret
POSTGRES_DB=zabbix

# Zabbix Server: connector workers (StartConnectors) and config cache reload period (s).
ZBX_STARTCONNECTORS=1
ZBX_CACHEUPDATEFREQUENCY=10

# Metrics streaming. Read only by init/setup-streaming.sh, which configures the
# Zabbix connector through the API. Never commit a real token.
STREAMING_ENABLED=false
STREAMING_URL=
STREAMING_BEARER_TOKEN=

# Diagnostic receiver (profile streaming-test): also log the raw NDJSON body.
RECEIVER_LOG_RAW=false
